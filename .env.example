# Copy values into your shell (export ...) — the backend reads real environment variables.
# Nothing here is required for offline development.

# Upload limit in MB (default 10)
# MODELLEDGER_MAX_UPLOAD_MB=10

# Comma-separated origins allowed by CORS (default: localhost:8000)
# MODELLEDGER_CORS_ORIGINS=http://127.0.0.1:8000,http://localhost:8000

# Phase 3: set after starting Hardhat and deploying ModelLedgerRegistry
# MODELLEDGER_RPC_URL=http://127.0.0.1:8545
# MODELLEDGER_CONTRACT_ADDRESS=
# MODELLEDGER_TX_PRIVATE_KEY=

# Phase 4: optional secp256k1 PEM key used to sign provenance claims.
# MODELLEDGER_SIGNATURE_PRIVATE_KEY_PEM=-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----

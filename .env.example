# ModelLedger — Environment Configuration Template
# Copy this file to .env or export the variables in your execution environment.
# All variables are optional for local offline development; defaults are provided.

# ---------------------------------------------------------------------------
# Database & Storage
# ---------------------------------------------------------------------------
# Path to persistent SQLite database file (default: data/modelledger.db)
MODELLEDGER_DB_PATH=data/modelledger.db

# Maximum allowed artifact upload size in megabytes (default: 10)
MODELLEDGER_MAX_UPLOAD_MB=10

# ---------------------------------------------------------------------------
# HTTP & CORS Configuration
# ---------------------------------------------------------------------------
# Comma-separated list of origins permitted to call the backend API
MODELLEDGER_CORS_ORIGINS=http://127.0.0.1:8000,http://localhost:8000

# ---------------------------------------------------------------------------
# Blockchain Integration (Optional — Leave blank for offline demonstration)
# ---------------------------------------------------------------------------
# JSON-RPC URL for the EVM network (e.g., local Hardhat node or Sepolia testnet)
# MODELLEDGER_RPC_URL=http://127.0.0.1:8545

# Deployed ModelLedgerRegistry smart contract address
# MODELLEDGER_CONTRACT_ADDRESS=0x5FbDB2315678afecb367f032d93F642f64180aa3

# Ethereum private key for committing transactions on-chain (do not commit real keys!)
# MODELLEDGER_TX_PRIVATE_KEY=

# ---------------------------------------------------------------------------
# Cryptographic Signatures & Proof of Creator
# ---------------------------------------------------------------------------
# Optional SECP256k1 PEM private key for signing canonical provenance events.
# If omitted, provenance claims operate without signed certificates.
# MODELLEDGER_SIGNATURE_PRIVATE_KEY_PEM=
